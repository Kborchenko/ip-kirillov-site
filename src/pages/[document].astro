---
import Page from "../layouts/Page.astro";
import LegalContent from "../components/LegalContent";
import { documents, legalRevision } from "../components/legalDocuments";

export function getStaticPaths() {
  return documents.map(doc => ({ params: { document: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
---
<Page page={doc.slug} title={doc.title} description={doc.description}>
  <article class="wrap policy-page">
    <a class="document-link" href="/#legal">К реквизитам агентства</a>
    <h1>{doc.title}</h1>
    <p class="policy-date">Редакция от <time datetime={legalRevision.iso}>{legalRevision.label}</time></p>
    <LegalContent slug={doc.slug}/>
  </article>
</Page>
